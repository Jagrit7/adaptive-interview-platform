# Copy to .env in the repo root, then `docker compose up --build`.
# .env is gitignored. Never commit real values.

# --- Backend (server-side only, never reaches the browser) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
GROQ_API_KEY=
SUPABASE_URL=
# Recommended current server key: sb_secret_...
SUPABASE_SECRET_KEY=
# Optional legacy fallback. Never expose either key as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origin allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Tuning (optional; the defaults below are what the code uses) ---

# How long an Agora agent may sit silent before Agora ends its task. Every
# specialist joins at session start and then waits its turn, so the 180s the SDK
# defaults to reaped interviewers mid-panel. Sized for a whole interview.
AGENT_IDLE_TIMEOUT_SECONDS=1800

# How long an untouched interview session is kept in the backend's memory before
# it is swept and its agents stopped. Sessions live in-process, so this is what
# bounds memory on a long-running server and stops an abandoned tab paying for
# agent time.
SESSION_TTL_SECONDS=10800

# --- Frontend (NEXT_PUBLIC_*: baked into the bundle at build time, public) ---
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

NEXT_PUBLIC_SUPABASE_URL=
# Use ONE of the two below - whichever your Supabase dashboard gave you.
# New projects: publishable (sb_publishable_...). Older: legacy anon (a JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the Supabase secret / service_role key in a NEXT_PUBLIC_ variable.
# It bypasses Row Level Security and would ship in the browser bundle.
